@model CreatePurchaseViewModel
@{
    ViewData["Title"] = "Nouvel achat";
}

<div class="page-header">
    <h1 class="h4 mb-0">Nouvel achat fournisseur</h1>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card landing-card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SupplierName" class="form-label"></label>
                    <input asp-for="SupplierName" class="form-control" autocomplete="off" autofocus
                           list="supplier-suggestions" placeholder="Ex. : Condor Distribution" />
                    <datalist id="supplier-suggestions">
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Name"></option>
                        }
                    </datalist>
                    <span asp-validation-for="SupplierName" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SupplierPhone" class="form-label"></label>
                    <input asp-for="SupplierPhone" class="form-control font-mono" autocomplete="off"
                           inputmode="numeric" placeholder="0X XX XX XX XX" />
                    <div class="form-text">Utilisé seulement si le fournisseur est nouveau.</div>
                    <span asp-validation-for="SupplierPhone" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="InvoiceNumber" class="form-label"></label>
                    <input asp-for="InvoiceNumber" class="form-control" autocomplete="off" />
                    <span asp-validation-for="InvoiceNumber" class="field-error"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="InvoiceDate" class="form-label"></label>
                    <input asp-for="InvoiceDate" class="form-control" type="date" />
                    <span asp-validation-for="InvoiceDate" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select" id="payment-method">
                        <option value="Cheque">Chèque</option>
                        <option value="Cash">Espèces</option>
                    </select>
                    <span asp-validation-for="PaymentMethod" class="field-error"></span>
                </div>
                <div class="col-md-3" id="check-number-group">
                    <label asp-for="CheckNumber" class="form-label"></label>
                    <input asp-for="CheckNumber" class="form-control" autocomplete="off" />
                    <span asp-validation-for="CheckNumber" class="field-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card landing-card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6">Lignes de l'achat</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-dense align-middle mb-0" id="lines-table">
                <thead>
                    <tr>
                        <th style="width: 45%;">Produit</th>
                        <th class="text-end" style="width: 12%;">Quantité</th>
                        <th class="text-end" style="width: 18%;">Coût unitaire</th>
                        <th class="text-end" style="width: 15%;">Total</th>
                        <th style="width: 10%;"></th>
                    </tr>
                </thead>
                <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" name="Lines.Index" value="@i" />
                                <select name="Lines[@i].ProductId" class="form-select form-select-sm line-product">
                                    <option value="">— Choisir un produit —</option>
                                    @foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Id" data-cost="@p.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                selected="@(Model.Lines[i].ProductId == p.Id)">@p.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" type="number" min="1"
                                       class="form-control form-control-sm line-qty font-mono text-end" />
                            </td>
                            <td>
                                <input name="Lines[@i].UnitCost" value="@(Model.Lines[i].UnitCost?.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" step="0.01" min="0"
                                       class="form-control form-control-sm line-cost font-mono text-end" />
                            </td>
                            <td class="text-end font-mono line-total">—</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-danger btn-sm line-remove" title="Retirer la ligne">&times;</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="add-line">
                                + Ajouter une ligne
                            </button>
                        </td>
                        <td colspan="2" class="text-end fw-semibold">Total de l'achat</td>
                        <td class="text-end font-mono fw-semibold" id="grand-total">—</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="form-text mb-3">
        À l'enregistrement, le stock de chaque produit est augmenté automatiquement et le
        mouvement correspondant est écrit dans son grand livre (quantités avant / après calculées par le système).
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer l'achat</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
    </div>
</form>

<template id="line-template">
    <tr>
        <td>
            <input type="hidden" name="Lines.Index" value="__i__" />
            <select name="Lines[__i__].ProductId" class="form-select form-select-sm line-product">
                <option value="">— Choisir un produit —</option>
                @foreach (var p in Model.Products)
                {
                    <option value="@p.Id" data-cost="@p.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Name</option>
                }
            </select>
        </td>
        <td>
            <input name="Lines[__i__].Quantity" value="1" type="number" min="1"
                   class="form-control form-control-sm line-qty font-mono text-end" />
        </td>
        <td>
            <input name="Lines[__i__].UnitCost" type="number" step="0.01" min="0"
                   class="form-control form-control-sm line-cost font-mono text-end" />
        </td>
        <td class="text-end font-mono line-total">—</td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-danger btn-sm line-remove" title="Retirer la ligne">&times;</button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const body = document.getElementById('lines-body');
            const template = document.getElementById('line-template');
            let nextIndex = @Model.Lines.Count;

            function formatDa(value) {
                return new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 2 }).format(value) + ' DA';
            }

            function recompute() {
                let grand = 0;
                body.querySelectorAll('tr').forEach(function (row) {
                    const qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                    const cost = parseFloat(row.querySelector('.line-cost').value) || 0;
                    const total = qty * cost;
                    row.querySelector('.line-total').textContent = total > 0 ? formatDa(total) : '—';
                    grand += total;
                });
                document.getElementById('grand-total').textContent = grand > 0 ? formatDa(grand) : '—';
            }

            function addLine() {
                const html = template.innerHTML.replaceAll('__i__', nextIndex++);
                const fragment = document.createElement('tbody');
                fragment.innerHTML = html;
                body.appendChild(fragment.firstElementChild);
                recompute();
            }

            document.getElementById('add-line').addEventListener('click', addLine);

            body.addEventListener('click', function (e) {
                if (e.target.closest('.line-remove')) {
                    e.target.closest('tr').remove();
                    recompute();
                }
            });

            body.addEventListener('input', function (e) {
                if (e.target.matches('.line-qty, .line-cost')) recompute();
            });

            // Pré-remplit le coût unitaire depuis le catalogue au choix du produit.
            body.addEventListener('change', function (e) {
                if (e.target.matches('.line-product')) {
                    const cost = e.target.selectedOptions[0]?.dataset.cost;
                    const costInput = e.target.closest('tr').querySelector('.line-cost');
                    if (cost && !costInput.value) costInput.value = cost;
                    recompute();
                }
            });

            // N° de chèque affiché uniquement pour un règlement par chèque.
            const paymentSelect = document.getElementById('payment-method');
            const checkGroup = document.getElementById('check-number-group');
            function toggleCheckNumber() {
                checkGroup.style.display = paymentSelect.value === 'Cheque' ? '' : 'none';
            }
            paymentSelect.addEventListener('change', toggleCheckNumber);

            toggleCheckNumber();
            recompute();
        })();
    </script>
}
