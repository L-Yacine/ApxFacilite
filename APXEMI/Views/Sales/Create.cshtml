@model CreateSaleViewModel
@{
    ViewData["Title"] = "Nouvelle vente";
    var showNewClientFields = !string.IsNullOrEmpty(Model.AccountNumber)
        || !string.IsNullOrEmpty(Model.AccountKey)
        || !string.IsNullOrEmpty(Model.LastName)
        || !string.IsNullOrEmpty(Model.FirstName)
        || !string.IsNullOrEmpty(Model.Phone)
        || !string.IsNullOrEmpty(Model.DossierNumber);
    var hasSelectedClient = Model.ClientId.HasValue;
}

<div class="page-header">
    <h1 class="h4 mb-0">Nouvelle vente — plan de mensualités</h1>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div class="card landing-card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6">Client</h2>
            <div class="form-text mb-2">Recherchez un client existant pour éviter les doublons, ou créez-en un nouveau.</div>
        </div>
        <div class="card-body pt-2">

            <div id="client-search-block" class="@(hasSelectedClient ? "d-none" : "")">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-6">
                        <input id="client-search-input" class="form-control form-control-sm" autocomplete="off"
                               placeholder="Nom, prénom, téléphone ou n° de compte…" value="@Model.ClientSearch" />
                    </div>
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="client-search-btn">Rechercher</button>
                    </div>
                </div>
                <div id="client-results" class="mt-2"></div>
                <button type="button" class="btn btn-link btn-sm p-0 mt-2" id="new-client-toggle">
                    + Créer un nouveau client
                </button>

                <div id="new-client-fields" class="row g-3 mt-1 @(showNewClientFields ? "" : "d-none")">
                    <div class="col-md-3">
                        <label asp-for="AccountNumber" class="form-label"></label>
                        <input asp-for="AccountNumber" class="form-control font-mono" autocomplete="off" inputmode="numeric" />
                        <span asp-validation-for="AccountNumber" class="field-error"></span>
                    </div>
                    <div class="col-md-1">
                        <label asp-for="AccountKey" class="form-label"></label>
                        <input asp-for="AccountKey" class="form-control font-mono" autocomplete="off" inputmode="numeric" />
                        <span asp-validation-for="AccountKey" class="field-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="LastName" class="field-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="FirstName" class="field-error"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control font-mono" autocomplete="off"
                               inputmode="numeric" placeholder="0X XX XX XX XX" />
                        <span asp-validation-for="Phone" class="field-error"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="DossierNumber" class="form-label"></label>
                        <input asp-for="DossierNumber" class="form-control" autocomplete="off"
                               placeholder="Dossier papier" />
                        <span asp-validation-for="DossierNumber" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div id="client-selected-block" class="@(hasSelectedClient ? "" : "d-none")">
                <div class="d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                    <span class="fw-semibold" id="client-selected-name">@Model.ClientFullName</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="client-change-btn">Changer</button>
                </div>
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="ClientFullName" />
            </div>

        </div>
    </div>

    <div class="card landing-card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6">Produits vendus</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-dense align-middle mb-0" id="lines-table">
                <thead>
                    <tr>
                        <th style="width: 38%;">Produit</th>
                        <th class="text-end" style="width: 11%;">Quantité</th>
                        <th class="text-end" style="width: 16%;">Prix unitaire</th>
                        <th class="text-end" style="width: 15%;">Total</th>
                        <th style="width: 10%;">Stock</th>
                        <th style="width: 10%;"></th>
                    </tr>
                </thead>
                <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" name="Lines.Index" value="@i" />
                                <select name="Lines[@i].ProductId" class="form-select form-select-sm line-product">
                                    <option value="">— Choisir un produit —</option>
                                    @foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Id"
                                                data-price="@p.UnitSalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-stock="@p.Stock"
                                                selected="@(Model.Lines[i].ProductId == p.Id)">@p.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" type="number" min="1"
                                       class="form-control form-control-sm line-qty font-mono text-end" />
                            </td>
                            <td>
                                <input name="Lines[@i].UnitPrice" value="@(Model.Lines[i].UnitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" step="0.01" min="0"
                                       class="form-control form-control-sm line-price font-mono text-end" />
                            </td>
                            <td class="text-end font-mono line-total">—</td>
                            <td class="line-stock text-muted font-mono">—</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-danger btn-sm line-remove" title="Retirer la ligne">&times;</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="add-line">
                                + Ajouter une ligne
                            </button>
                        </td>
                        <td colspan="2" class="text-end fw-semibold">Total de la vente</td>
                        <td class="text-end font-mono fw-semibold" id="grand-total">—</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="card landing-card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6">Conditions de paiement</h2>
        </div>
        <div class="card-body pt-2">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="SaleDate" class="form-label"></label>
                    <input asp-for="SaleDate" class="form-control" type="date" />
                    <span asp-validation-for="SaleDate" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DownPayment" class="form-label"></label>
                    <input asp-for="DownPayment" class="form-control font-mono text-end" type="number" step="0.01" min="0" />
                    <div class="form-text">Versement encaissé à la vente ; le reste est réparti sur les mensualités.</div>
                    <span asp-validation-for="DownPayment" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="NumberOfInstalments" class="form-label"></label>
                    <input asp-for="NumberOfInstalments" class="form-control font-mono text-end" type="number" min="1" max="24" />
                    <span asp-validation-for="NumberOfInstalments" class="field-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="InstalmentAmount" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="InstalmentAmount" class="form-control font-mono text-end" type="number" step="0.01" min="0" />
                        <button type="button" class="btn btn-outline-secondary" id="reset-amount" title="Recalculer la mensualité">↺</button>
                    </div>
                    <div class="form-text">Pré-calculée ; modifiable avant confirmation.</div>
                    <span asp-validation-for="InstalmentAmount" class="field-error"></span>
                </div>
            </div>

            <div class="row g-3 mt-1 align-items-baseline">
                <div class="col-md-3">
                    <span class="text-muted">Montant financé</span>
                    <div class="font-mono fw-semibold" id="financed-amount">—</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Dernière mensualité (absorbe l'arrondi)</span>
                    <div class="font-mono" id="last-amount">—</div>
                </div>
            </div>

            <div class="mt-3">
                <h3 class="h6">Échéances prévues</h3>
                <div class="table-responsive">
                    <table class="table table-dense align-middle mb-0" style="max-width: 520px;">
                        <thead>
                            <tr>
                                <th class="text-end" style="width: 12%;">N°</th>
                                <th>Échéance</th>
                                <th>Référence</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody id="schedule-body">
                            <tr><td colspan="4" class="text-muted">Saisissez la date, le nombre de mensualités et les produits pour voir l'échéancier.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="form-text mb-3">
        À l'enregistrement, le stock de chaque produit est déduit automatiquement, les mouvements sont
        écrits dans le grand livre et le calendrier des mensualités est généré — chaque vente constitue
        son propre plan, indépendant des autres plans du client.
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer la vente</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
    </div>
</form>

<template id="line-template">
    <tr>
        <td>
            <input type="hidden" name="Lines.Index" value="__i__" />
            <select name="Lines[__i__].ProductId" class="form-select form-select-sm line-product">
                <option value="">— Choisir un produit —</option>
                @foreach (var p in Model.Products)
                {
                    <option value="@p.Id"
                            data-price="@p.UnitSalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-stock="@p.Stock">@p.Name</option>
                }
            </select>
        </td>
        <td>
            <input name="Lines[__i__].Quantity" value="1" type="number" min="1"
                   class="form-control form-control-sm line-qty font-mono text-end" />
        </td>
        <td>
            <input name="Lines[__i__].UnitPrice" type="number" step="0.01" min="0"
                   class="form-control form-control-sm line-price font-mono text-end" />
        </td>
        <td class="text-end font-mono line-total">—</td>
        <td class="line-stock text-muted font-mono">—</td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-danger btn-sm line-remove" title="Retirer la ligne">&times;</button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const body = document.getElementById('lines-body');
            const template = document.getElementById('line-template');
            let nextIndex = @Model.Lines.Count;

            const saleDateInput = document.getElementById('SaleDate');
            const downInput = document.getElementById('DownPayment');
            const countInput = document.getElementById('NumberOfInstalments');
            const amountInput = document.getElementById('InstalmentAmount');
            const resetAmountBtn = document.getElementById('reset-amount');
            const scheduleBody = document.getElementById('schedule-body');
            let amountUserEdited = false;

            function formatDa(value) {
                return new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 2 }).format(value) + ' DA';
            }

            function grandTotal() {
                let grand = 0;
                body.querySelectorAll('tr').forEach(function (row) {
                    const qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.line-price').value) || 0;
                    grand += qty * price;
                });
                return grand;
            }

            function recomputeLines() {
                let grand = 0;
                body.querySelectorAll('tr').forEach(function (row) {
                    const qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.line-price').value) || 0;
                    const total = qty * price;
                    const option = row.querySelector('.line-product').selectedOptions[0];
                    const stock = option ? parseInt(option.dataset.stock || '0', 10) : 0;
                    const stockCell = row.querySelector('.line-stock');

                    row.querySelector('.line-total').textContent = total > 0 ? formatDa(total) : '—';
                    stockCell.textContent = option && option.value ? (stock + ' dispo') : '—';
                    stockCell.classList.toggle('text-danger', option && option.value && qty > stock);
                    grand += total;
                });
                document.getElementById('grand-total').textContent = grand > 0 ? formatDa(grand) : '—';
                document.getElementById('financed-amount').textContent = grand > 0 ? formatDa(grand) : '—';
            }

            function dueDateFor(monthOffset) {
                const parts = saleDateInput.value ? saleDateInput.value.split('-').map(Number) : null;
                if (!parts || parts.length !== 3) return null;
                const year = parts[0], month = parts[1], day = parts[2];
                const m = month + monthOffset;
                const targetYear = year + Math.floor((m - 1) / 12);
                const targetMonth = ((m - 1) % 12) + 1;
                const lastDay = new Date(targetYear, targetMonth, 0).getDate();
                return { year: targetYear, month: targetMonth, day: Math.min(day, lastDay) };
            }

            function recomputeSchedule() {
                const total = grandTotal();
                const down = parseFloat(downInput.value) || 0;
                const financed = Math.max(0, total - down);
                const n = parseInt(countInput.value, 10) || 0;

                const auto = n > 0 ? Math.round(financed / n * 100) / 100 : 0;
                const amount = amountUserEdited ? (parseFloat(amountInput.value) || 0) : auto;
                const last = financed - amount * (n - 1);

                document.getElementById('financed-amount').textContent =
                    total > 0 ? formatDa(financed) : '—';
                document.getElementById('last-amount').textContent =
                    n > 0 && total > 0 ? formatDa(last) : '—';

                if (n < 1 || total <= 0) {
                    scheduleBody.innerHTML =
                        '<tr><td colspan="4" class="text-muted">Saisissez la date, le nombre de mensualités et les produits pour voir l\'échéancier.</td></tr>';
                    return;
                }

                let html = '';
                for (let i = 1; i <= n; i++) {
                    const d = dueDateFor(i);
                    if (!d) {
                        scheduleBody.innerHTML =
                            '<tr><td colspan="4" class="text-muted">Choisissez une date de vente pour afficher l\'échéancier.</td></tr>';
                        return;
                    }
                    const due = d.day + '/' + String(d.month).padStart(2, '0') + '/' + d.year;
                    const ref = String(d.month).padStart(2, '0') + '/' + d.year;
                    const amt = i === n ? last : amount;
                    html += '<tr>' +
                        '<td class="text-end font-mono">' + i + '</td>' +
                        '<td class="font-mono">' + due + '</td>' +
                        '<td class="font-mono text-muted">' + ref + '</td>' +
                        '<td class="text-end font-mono">' + formatDa(amt) + '</td>' +
                        '</tr>';
                }
                scheduleBody.innerHTML = html;
            }

            function setAutoAmount() {
                const total = grandTotal();
                const down = parseFloat(downInput.value) || 0;
                const n = parseInt(countInput.value, 10) || 0;
                if (n > 0 && total > 0) {
                    amountInput.value = (Math.round((total - down) / n * 100) / 100).toString();
                }
            }

            function refreshTerms() {
                recomputeLines();
                if (!amountUserEdited) setAutoAmount();
                recomputeSchedule();
            }

            function addLine() {
                const html = template.innerHTML.replaceAll('__i__', nextIndex++);
                const fragment = document.createElement('tbody');
                fragment.innerHTML = html;
                body.appendChild(fragment.firstElementChild);
                refreshTerms();
            }

            document.getElementById('add-line').addEventListener('click', addLine);

            body.addEventListener('click', function (e) {
                if (e.target.closest('.line-remove')) {
                    e.target.closest('tr').remove();
                    refreshTerms();
                }
            });

            body.addEventListener('input', function (e) {
                if (e.target.matches('.line-qty, .line-price')) refreshTerms();
            });

            // Pré-remplit le prix de vente depuis le catalogue au choix du produit.
            body.addEventListener('change', function (e) {
                if (e.target.matches('.line-product')) {
                    const price = e.target.selectedOptions[0]?.dataset.price;
                    const priceInput = e.target.closest('tr').querySelector('.line-price');
                    if (price && !priceInput.value) priceInput.value = price;
                    refreshTerms();
                }
            });

            downInput.addEventListener('input', refreshTerms);
            countInput.addEventListener('input', refreshTerms);
            saleDateInput.addEventListener('input', recomputeSchedule);

            amountInput.addEventListener('input', function () {
                amountUserEdited = true;
                recomputeSchedule();
            });

            resetAmountBtn.addEventListener('click', function () {
                amountUserEdited = false;
                setAutoAmount();
                recomputeSchedule();
            });

            // --- Recherche de client ---
            const searchBlock = document.getElementById('client-search-block');
            const selectedBlock = document.getElementById('client-selected-block');
            const resultsBox = document.getElementById('client-results');
            const searchInput = document.getElementById('client-search-input');
            const searchBtn = document.getElementById('client-search-btn');
            const newClientToggle = document.getElementById('new-client-toggle');
            const newClientFields = document.getElementById('new-client-fields');
            const clientIdInput = document.getElementById('ClientId');
            const clientFullNameInput = document.getElementById('ClientFullName');
            const selectedName = document.getElementById('client-selected-name');

            function selectClient(id, fullName) {
                clientIdInput.value = id;
                clientFullNameInput.value = fullName;
                selectedName.textContent = fullName;
                searchBlock.classList.add('d-none');
                selectedBlock.classList.remove('d-none');
                searchInput.value = '';
                resultsBox.innerHTML = '';
            }

            searchBtn.addEventListener('click', async function () {
                const q = searchInput.value.trim();
                if (!q) return;
                resultsBox.innerHTML = '<span class="text-muted">Recherche…</span>';
                const res = await fetch('/Clients/Search?q=' + encodeURIComponent(q));
                const clients = await res.json();
                if (!clients.length) {
                    resultsBox.innerHTML = '<span class="text-muted">Aucun client trouvé — vous pouvez en créer un nouveau.</span>';
                    return;
                }
                resultsBox.innerHTML = clients.map(function (c) {
                    return '<div class="d-flex align-items-center gap-2 mb-1">' +
                        '<button type="button" class="btn btn-outline-primary btn-sm" ' +
                        'data-id="' + c.id + '" data-name="' + c.fullName.replace(/"/g, '&quot;') + '">Choisir</button>' +
                        '<span class="fw-semibold">' + c.fullName + '</span>' +
                        '<span class="text-muted font-mono">compte ' + c.accountNumber + '</span>' +
                        (c.phone ? '<span class="text-muted font-mono">' + c.phone + '</span>' : '') +
                        '</div>';
                }).join('');
            });

            resultsBox.addEventListener('click', function (e) {
                const btn = e.target.closest('button[data-id]');
                if (btn) selectClient(btn.dataset.id, btn.dataset.name);
            });

            newClientToggle.addEventListener('click', function () {
                const hidden = newClientFields.classList.contains('d-none');
                newClientFields.classList.toggle('d-none', !hidden);
                if (hidden && clientIdInput.value) {
                    clientIdInput.value = '';
                    clientFullNameInput.value = '';
                    selectedBlock.classList.add('d-none');
                    searchBlock.classList.remove('d-none');
                }
                this.textContent = hidden ? '− Masquer le formulaire du nouveau client' : '+ Créer un nouveau client';
            });

            if (!newClientFields.classList.contains('d-none')) {
                newClientToggle.textContent = '− Masquer le formulaire du nouveau client';
            }

            document.getElementById('client-change-btn').addEventListener('click', function () {
                clientIdInput.value = '';
                clientFullNameInput.value = '';
                selectedBlock.classList.add('d-none');
                searchBlock.classList.remove('d-none');
            });

            refreshTerms();
        })();
    </script>
}
