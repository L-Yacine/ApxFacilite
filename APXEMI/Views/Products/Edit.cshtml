@model EditProductViewModel
@{
    ViewData["Title"] = "Modifier le produit";
}

<div class="page-header">
    <h1 class="h4 mb-0">Modifier le produit</h1>
    @if (Model.IsActive)
    {
        <span class="status-pill status-pill-active">Actif</span>
    }
    else
    {
        <span class="status-pill status-pill-inactive">Retiré</span>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card landing-card h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Informations du produit</h2>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <div class="input-group">
                            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">— Sélectionner —</option>
                            </select>
                            <a asp-controller="Catalog" asp-action="CreateCategory" class="btn btn-outline-secondary"
                               title="Ajouter une catégorie" aria-label="Ajouter une catégorie">+</a>
                        </div>
                        <span asp-validation-for="CategoryId" class="field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label"></label>
                        <div class="input-group">
                            <select asp-for="BrandId" asp-items="Model.BrandOptions" class="form-select">
                                <option value="">— Sélectionner —</option>
                            </select>
                            <a asp-controller="Catalog" asp-action="CreateBrand" class="btn btn-outline-secondary"
                               title="Ajouter une marque" aria-label="Ajouter une marque">+</a>
                        </div>
                        <span asp-validation-for="BrandId" class="field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UnitCost" class="form-label"></label>
                        <input asp-for="UnitCost" class="form-control font-mono" type="number" step="0.01" min="0"
                               inputmode="decimal" autocomplete="off" />
                        <span asp-validation-for="UnitCost" class="field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UnitSalePrice" class="form-label"></label>
                        <input asp-for="UnitSalePrice" class="form-control font-mono" type="number" step="0.01" min="0"
                               inputmode="decimal" autocomplete="off" />
                        <span asp-validation-for="UnitSalePrice" class="field-error"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card landing-card h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Informations système</h2>

                <div class="mb-3">
                    <label class="form-label">Stock actuel</label>
                    <div class="font-mono fs-5"
                         title="Calculé automatiquement à partir des achats et des ventes — jamais modifiable à la main">
                        @Model.CurrentStockQuantity
                    </div>
                    <div class="form-text">
                        Calculé automatiquement à partir des achats et des ventes — jamais modifiable à la main.
                    </div>
                </div>

                <div class="text-muted small">
                    Créé le @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    @(Model.CreatedByName is null ? string.Empty : $"par {Model.CreatedByName}")
                    @if (Model.UpdatedAtUtc is { } updatedAt)
                    {
                        <br />
                        @:Dernière modification le @updatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        @(Model.UpdatedByName is null ? string.Empty : $"par {Model.UpdatedByName}")
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
